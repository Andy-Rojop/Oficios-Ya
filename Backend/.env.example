PORT=4000
NODE_ENV=development

# PostgreSQL en Supabase (nube). No usar base de datos local.
# Settings → Database → Connection string
#
# DATABASE_URL: Transaction pooler (puerto 6543) para el runtime de la API
# DIRECT_URL:   Direct connection (puerto 5432) para migraciones Prisma
#
# Reemplazá [PROJECT-REF] y [YOUR-PASSWORD] con los valores de tu proyecto.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

FRONTEND_URL=http://localhost:3000
# Local: localhost. Prod cross-origin (Vercel↔Render): dejar vacío y COOKIE_SAMESITE=none
COOKIE_DOMAIN=localhost
COOKIE_SAMESITE=lax
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=public-media
SUPABASE_PRIVATE_BUCKET=chat-media
UPLOAD_MAX_MB=5
SENTRY_DSN=
