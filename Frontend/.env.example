NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Firebase (verificación de teléfono por SMS). Copia estos valores desde
# Firebase console > Configuración del proyecto > Tus apps > App web (</>).
# authDomain y projectId del proyecto OficiosYa:
#   NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=oficios-ya-b33aa.firebaseapp.com
#   NEXT_PUBLIC_FIREBASE_PROJECT_ID=oficios-ya-b33aa
# apiKey y appId salen de la consola (no se versionan).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=oficios-ya-b33aa.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=oficios-ya-b33aa
NEXT_PUBLIC_FIREBASE_APP_ID=

NEXT_PUBLIC_SENTRY_DSN=

# Opcional: host del bucket publico de Supabase para next/image (por defecto se permite *.supabase.co)
# NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
